{
	"name": "vibe-0",
	"version": "1.3.0",
	"description": "Asynchronous I/O framework",
	"license": "MIT",
	"copyright": "Copyright © 2012-2014 Sönke Ludwig",
	"homepage": "http://vibed.org/",
	"authors": [
			"Sönke Ludwig",
			"Jan Krüger",
			"Matthias Dondorff",
			"Etienne Cimon",
			"see github for more"
	],

	"dependencies": {
		"libhttp2": { "version": "~>1.0.0" },
		"botan": {
			"version": ">=3.13.0",
			"repository": "git+https://github.com/etcimon/botan.git"
		},
		"libasync": {"version": "~>0.9.0" },
		"openssl": {
			"version": ">=3.3.4",
			"repository": "git+https://github.com/etcimon/openssl.git"
		},
		"memutils": {
			"version": ">=1.0.13",
			"repository": "git+https://github.com/etcimon/memutils.git"
		}
	},
	"targetType": "library",
	"mainSourceFile": "source/vibe/appmain.d",
	"buildRequirements": ["requireBoundsCheck"],
	"libs-posix": ["sqlite3", "dl", "pthread","brotlicommon","brotlidec","brotlienc", "ssl", "crypto"],
	"lflags-windows-x86_64": [
		"/LIBPATH:$PACKAGE_DIR/lib/openssl-win64-x64",
		"/LIBPATH:$PACKAGE_DIR/lib/brotli-win64-x64",
		"/LIBPATH:$PACKAGE_DIR/lib"
	],
	"libs-windows-x86_64": [
		"libssl",
		"libcrypto",
		"sqlite3_x64",
		"brotlicommon",
		"brotlienc",
		"brotlidec"
	],
	"lflags-windows-x86": [
		"/LIBPATH:$PACKAGE_DIR/lib/openssl-win32-x86",
		"/LIBPATH:$PACKAGE_DIR/lib/brotli-win32-x86",
		"/LIBPATH:$PACKAGE_DIR/lib"
	],
	"libs-windows-x86": [
		"libssl",
		"libcrypto",
		"sqlite3_x86",
		"brotlicommon",
		"brotlienc",
		"brotlidec"
	],
	"subConfigurations": {
		"botan": "full",
		"openssl": "library-manual-link"
	},
	"versions": [
		"Have_vibe_d", "EnableDebugger", "VibeCustomMain", "DeimosOpenSSL_3_0",
		"X509", "TLS", "TLS_13", "OCSP_Staple", "CertStore_System", "CertStore_Flatfile"
	],
	"-ddoxFilterArgs": ["--unittest-examples", "--min-protection=Protected", "--ex", "vibe.core.drivers.", "--ex", "vibe.internal."],
	"libs-windows": ["psapi", "Crypt32"],
	"lflags-windows": ["/nodefaultlib:msvcrt", "/nodefaultlib:vcruntime"]
}
